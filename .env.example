# Secrets JAROD — Ne jamais commiter les valeurs réelles
# Injectés via GitHub Secrets → CI/CD → --extra-vars

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
DISCORD_BOT_TOKEN=
GITHUB_TOKEN=

# Discord Gateway
DISCORD_ALLOWED_USERS=<votre-user-id-discord>
DISCORD_HOME_CHANNEL=<channel-id-pour-notifications-optionnel>
DISCORD_COMMAND_SYNC_POLICY=safe
TAVILY_API_KEY=<votre-cle-api-tavily>

# STT Cloud Fallback (optionnel — si absent, STT local utilisé)
GROQ_API_KEY=<votre-cle-groq-optionnelle>

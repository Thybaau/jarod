# Kubeconfig JAROD — accès au cluster homelab-k3s
# Généré par Ansible — ne pas éditer manuellement
# ServiceAccount: jarod (namespace kube-system)
# Permissions: ClusterRole jarod-phase1 (read + write non-destructif avec approbation)
---
apiVersion: v1
kind: Config
current-context: {{ kube_context_name }}

clusters:
  - name: {{ kube_cluster_name }}
    cluster:
      server: https://{{ k8s_master_ip }}:{{ k8s_api_port }}
      certificate-authority-data: {{ k8s_ca_data }}

users:
  - name: {{ kube_user_name }}
    user:
      token: {{ jarod_sa_token }}

contexts:
  - name: {{ kube_context_name }}
    context:
      cluster: {{ kube_cluster_name }}
      user: {{ kube_user_name }}

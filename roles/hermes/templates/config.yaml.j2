# Configuration Hermes Agent — JAROD
# Déployé via Ansible (template config.yaml.j2)
# Ne pas modifier directement — les changements seront écrasés au prochain déploiement

# === Provider LLM principal ===
model:
  provider: "{{ hermes_model_provider }}"
  default: "{{ hermes_model_default }}"

# === Chaîne de fallback ===
fallback_providers:
  - provider: "{{ hermes_fallback_provider }}"
    model: "{{ hermes_fallback_model }}"

# === Compression du contexte ===
compression:
  enabled: {{ hermes_compression_enabled | lower }}
  threshold: {{ hermes_compression_threshold }}
  target_ratio: {{ hermes_compression_target_ratio }}

# === Sécurité et approbations ===
approvals:
  mode: "{{ hermes_approvals_mode }}"
  timeout: {{ hermes_approvals_timeout }}
  cron_mode: "{{ hermes_approvals_cron_mode }}"
  deny:
{% for pattern in hermes_approvals_deny %}
    - '{{ pattern }}'
{% endfor %}

# === Sécurité réseau ===
security:
  allow_private_urls: true

# === Recherche web ===
web:
  search_backend: tavily
  extract_backend: tavily

# === Gateway Discord ===
discord:
  auto_thread: {{ hermes_discord_auto_thread | lower }}
  reactions: {{ hermes_discord_reactions | lower }}
{% if hermes_discord_free_response_channels %}
  free_response_channels: "{{ hermes_discord_free_response_channels }}"
{% endif %}
# === Prompts système par salon (éphémères, non persistés dans le transcript) ===
{% if hermes_discord_channel_prompts %}
  channel_prompts:
{% for channel_id, prompt in hermes_discord_channel_prompts.items() %}
    "{{ channel_id }}": |
      {{ prompt | indent(6) }}
{% endfor %}
{% endif %}

# === Canal home Discord ===
{% if hermes_discord_home_channel_id %}
platforms:
  discord:
    enabled: true
    home_channel:
      platform: discord
      chat_id: '{{ hermes_discord_home_channel_id }}'
      name: '{{ hermes_discord_home_channel_name }}'
      scope_id: '{{ hermes_discord_server_id }}'
{% endif %}

# === Speech-to-Text (transcription vocale) ===
stt:
  provider: "{{ hermes_stt_provider }}"
  language: "{{ hermes_stt_language }}"
  local:
    model: "{{ hermes_stt_local_model }}"
    language: "{{ hermes_stt_language }}"
{% if hermes_stt_initial_prompt %}
    initial_prompt: "{{ hermes_stt_initial_prompt }}"
{% endif %}

# === Text-to-Speech (synthèse vocale) ===
tts:
  provider: "{{ hermes_tts_provider }}"
  speed: {{ hermes_tts_speed | float }}
  edge:
    voice: "{{ hermes_tts_edge_voice }}"
    speed: {{ hermes_tts_speed | float }}

# === Sessions ===
group_sessions_per_user: true


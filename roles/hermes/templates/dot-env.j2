# Fichier .env — Secrets JAROD
# Généré par Ansible — ne pas éditer manuellement
# Permissions : 600 (lecture/écriture uniquement par jarod)
# Dernière mise à jour : {{ ansible_date_time.iso8601 }}

# === Sécurité Hermes ===
HERMES_REDACT_SECRETS=true

DEEPSEEK_API_KEY={{ deepseek_api_key }}
OPENROUTER_API_KEY={{ openrouter_api_key }}
DISCORD_BOT_TOKEN={{ discord_bot_token }}
GITHUB_TOKEN={{ github_token }}

# === WEB API KEY ===
TAVILY_API_KEY={{ tavily_api_key }}

# === Discord Gateway ===
DISCORD_ALLOWED_USERS={{ discord_allowed_users }}
DISCORD_REQUIRE_MENTION={{ hermes_discord_require_mention | lower }}
DISCORD_AUTO_THREAD={{ hermes_discord_auto_thread | lower }}
{% if hermes_discord_free_response_channels %}
DISCORD_FREE_RESPONSE_CHANNELS={{ hermes_discord_free_response_channels }}
{% endif %}
{% if hermes_discord_home_channel %}
DISCORD_HOME_CHANNEL={{ hermes_discord_home_channel }}
{% endif %}
